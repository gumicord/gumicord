# スパイク S4 の設定。このファイルをコピーして .env を作ってください。
#   cp .env.example .env
#
# .env は .gitignore 済みです。トークンはログにも出力しません (SEC-001)。

# ■ Bot トークンを強く推奨します。
#   Gateway のハンドシェイク・ハートビート・再接続・zstd・レート制限の機構は
#   ユーザーアカウントと完全に同一なので、4-1〜4-7 は Bot で検証できます。
#   その場合アカウント停止のリスクがありません。
#
#   作り方:
#     1. https://discord.com/developers/applications で New Application
#     2. Bot タブ → Reset Token でトークンを取得
#     3. Bot タブ → Privileged Gateway Intents で
#        MESSAGE CONTENT INTENT を有効化 (4-4 の検証に必要)
#     4. OAuth2 → URL Generator で scope=bot を選び、テスト用サーバーに招待
GUMICORD_TOKEN=

# bot または user
GUMICORD_TOKEN_KIND=bot

# 4-5 (メッセージ送信) の宛先チャンネル ID。空なら送信テストを飛ばします。
# チャンネルを右クリック → 「IDをコピー」(開発者モードが必要)
GUMICORD_CHANNEL_ID=

# zstd-stream を無効にしたい場合のみ、任意の値を設定してください
# GUMICORD_NO_ZSTD=1
