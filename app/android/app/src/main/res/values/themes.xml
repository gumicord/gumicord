<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GameActivity derives from AppCompat, so the theme must too. The
         window itself stays empty: Rust draws everything. -->
    <style name="GumicordTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
