{
  "$schema": "https://gumicord.dev/schema/theme-1.json",

  "manifest": {
    "id": "dev.gumicord.midnight",
    "name": "Midnight",
    "version": "1.0.0",
    "abi": 1,
    "author": "Gumicord",
    "description": "公式サンプルテーマ。テーマ仕様の全機能を一通り使う。",
    "license": "MIT"
  },

  "tokens": {
    "color.bg.base": "#0f0f17",
    "color.bg.raised": "#16161f",
    "color.bg.sunken": "#0a0a10",
    "color.bg.hover": "#ffffff0f",
    "color.bg.selected": "#ffffff1a",

    "color.text.primary": "#eaeaf0",
    "color.text.secondary": "#a0a0b0",
    "color.text.muted": "#6a6a7a",

    "color.brand": "#7c6cf0",
    "color.accent": "$color.brand",
    "color.danger": "#e05260",
    "color.border": "#ffffff14",

    "radius.sm": 4,
    "radius.md": 8,
    "radius.lg": 12,
    "radius.full": 9999,

    "space.1": 4,
    "space.2": 8,
    "space.3": 16,

    "font.body": { "size": 15, "lineHeight": 22 },
    "font.title": { "size": 16, "lineHeight": 22, "weight": 600 },
    "font.small": { "size": 12, "lineHeight": 16 },
    "font.mono": { "family": "Cascadia Code", "size": 13, "lineHeight": 20 },

    "shadow.raised": { "x": 0, "y": 2, "blur": 8, "color": "#00000059" },

    "motion.fast": 120,
    "motion.slow": 200
  },

  "rules": [
    {
      "select": "app.window",
      "style": {
        "background": "$color.bg.base",
        "color": "$color.text.primary",
        "font": "$font.body"
      }
    },

    {
      "select": "app.screen.login",
      "style": { "background": "$color.bg.base", "gap": "$space.3", "padding": [24, 24, 24, 24] }
    },
    {
      "select": "app.screen.login.title",
      "style": { "font": { "size": 22, "lineHeight": 30, "weight": 600 } }
    },
    {
      "select": "app.screen.login.hint",
      "style": { "color": "$color.text.secondary", "font": "$font.body" }
    },
    {
      "select": "primitive.qr",
      "style": {
        "background": "#ffffff",
        "color": "#000000",
        "radius": "$radius.md",
        "padding": [12, 12, 12, 12]
      }
    },

    {
      "select": "chrome.titlebar",
      "when": { "platform": "desktop" },
      "style": { "background": "$color.bg.sunken", "height": 32 }
    },
    {
      "select": "chrome.titlebar.title",
      "style": { "font": "$font.small", "color": "$color.text.muted" }
    },
    {
      "select": "chrome.titlebar.control",
      "style": { "font": "$font.small", "color": "$color.text.secondary", "transition": "$motion.fast" }
    },
    {
      "select": "chrome.titlebar.control",
      "when": { "state": "hover" },
      "style": { "background": "$color.bg.hover" }
    },

    {
      "select": "nav.guild_list",
      "style": { "background": "$color.bg.sunken", "padding": [12, 12, 12, 4], "gap": "$space.2" }
    },
    {
      "select": "nav.guild_list.item",
      "style": { "width": 56, "height": 48 }
    },
    {
      "select": "nav.guild_list.item",
      "when": { "state": "grouped" },
      "style": { "width": 48, "height": 48 }
    },
    {
      "select": "nav.guild_list.item",
      "when": { "platform": "mobile" },
      "style": { "width": 52, "height": 44 }
    },
    {
      "select": "nav.guild_list.item.pill",
      "style": {
        "width": 4,
        "height": 8,
        "margin": [0, 52, 0, 0],
        "radius": "$radius.full",
        "background": "$color.text.primary",
        "transition": "$motion.fast"
      }
    },
    {
      "select": "nav.guild_list.item.pill",
      "when": { "state": "hover" },
      "style": { "height": 20 }
    },
    {
      "select": "nav.guild_list.item.pill",
      "when": { "state": "selected" },
      "style": { "height": 40 }
    },
    {
      "select": "nav.guild_list.item.pill",
      "when": { "state": "grouped" },
      "style": { "margin": [0, 44, 0, 0] }
    },
    {
      "select": "nav.guild_list.item.icon",
      "style": {
        "width": 48,
        "height": 48,
        "margin": [0, 0, 0, 8],
        "radius": "$radius.lg",
        "background": "$color.bg.raised",
        "transition": "$motion.fast"
      }
    },
    {
      "select": "nav.guild_list.item.icon",
      "when": { "state": "hover" },
      "style": { "radius": "$radius.md" }
    },
    {
      "select": "nav.guild_list.item.icon",
      "when": { "state": "selected" },
      "style": { "radius": "$radius.md" }
    },
    {
      "select": "nav.guild_list.item.icon",
      "when": { "state": "grouped" },
      "style": { "width": 48, "height": 48, "margin": [0, 0, 0, 0] }
    },
    {
      "select": "nav.guild_list.item.icon",
      "when": { "state": "collapsed" },
      "style": {
        "width": 14,
        "height": 14,
        "margin": [1, 1, 1, 1],
        "radius": "$radius.sm",
        "font": { "size": 9, "lineHeight": 14 }
      }
    },
    {
      "select": "nav.guild_list.folder",
      "style": {
        "width": 48,
        "margin": [0, 0, 0, 8],
        "radius": "$radius.lg",
        "background": "$color.bg.hover",
        "padding": [0, 0, 4, 0],
        "gap": "$space.1",
        "transition": "$motion.fast"
      }
    },
    {
      "select": "nav.guild_list.folder",
      "when": { "state": "collapsed" },
      "style": {
        "height": 48,
        "radius": "$radius.md",
        "background": "$color.bg.raised",
        "borderColor": "$color.border",
        "borderWidth": 1,
        "padding": [6, 6, 6, 6]
      }
    },
    {
      "select": "nav.guild_list.folder",
      "when": { "state": "hover" },
      "style": { "background": "$color.bg.selected" }
    },
    {
      "select": "nav.guild_list.folder.icon",
      "style": { "color": "$color.text.secondary", "font": { "size": 26, "lineHeight": 26 } }
    },
    {
      "select": "nav.guild_list.folder.icon",
      "style": { "color": "$data.tint" }
    },
    {
      "select": "nav.guild_list.folder",
      "when": { "state": "collapsed" },
      "style": { "borderColor": "$data.tint" }
    },
    {
      "select": "nav.guild_list.item.badge",
      "style": {
        "margin": [32, 0, 0, 38],
        "borderColor": "$color.bg.sunken",
        "borderWidth": 2,
        "background": "$color.danger",
        "color": "#ffffff",
        "font": { "size": 12, "lineHeight": 16, "weight": 600 },
        "radius": "$radius.full",
        "padding": [0, 5, 0, 5]
      }
    },

    {
      "select": "nav.channel_list",
      "style": { "background": "$color.bg.raised", "padding": "$space.2" }
    },
    {
      "select": "nav.channel_list.header",
      "style": { "font": "$font.title", "padding": [0, 8, 0, 8] }
    },
    {
      "select": "nav.guild_list.home",
      "style": { "width": 48, "height": 48, "margin": [0, 0, 0, 8], "radius": "$radius.full", "background": "$color.brand", "color": "#ffffff" }
    },
    {
      "select": "nav.channel_list.item",
      "style": {
        "radius": "$radius.sm",
        "padding": [6, 8, 6, 8],
        "gap": 6,
        "color": "$color.text.secondary",
        "transition": "$motion.fast"
      }
    },
    {
      "select": "nav.channel_list.item",
      "when": { "state": "hover" },
      "style": { "background": "$color.bg.hover", "color": "$color.text.primary" }
    },
    {
      "select": "nav.channel_list.item",
      "when": { "state": "selected" },
      "style": { "background": "$color.bg.selected", "color": "$color.text.primary" }
    },
    {
      "select": "nav.channel_list.item",
      "when": { "state": "unread" },
      "style": { "color": "$color.text.primary" }
    },
    {
      "select": "nav.channel_list.item",
      "when": { "state": "mentioned" },
      "style": { "color": "$color.danger" }
    },
    {
      "select": "nav.channel_list.item.badge",
      "style": {
        "background": "$color.danger",
        "color": "#ffffff",
        "font": "$font.small",
        "radius": "$radius.full",
        "padding": [2, 6, 2, 6]
      }
    },
    {
      "select": "nav.channel_list.category",
      "style": { "font": "$font.small", "color": "$color.text.muted", "padding": [12, 8, 4, 8] }
    },

    {
      "select": "nav.user_panel",
      "style": { "background": "$color.bg.sunken", "padding": [0, 8, 0, 8], "gap": "$space.2" }
    },
    {
      "select": "nav.user_panel.avatar",
      "style": { "radius": "$radius.full", "background": "$color.bg.raised" }
    },
    {
      "select": "nav.user_panel.presence",
      "style": {
        "width": 14,
        "height": 14,
        "margin": [20, 0, 0, 20],
        "radius": "$radius.full",
        "background": "$color.text.muted",
        "borderColor": "$color.bg.sunken",
        "borderWidth": 2
      }
    },
    {
      "select": "nav.user_panel.presence",
      "when": { "slot": "online" },
      "style": { "background": "#3ba55d" }
    },
    {
      "select": "nav.user_panel.presence",
      "when": { "slot": "idle" },
      "style": { "background": "#faa81a" }
    },
    {
      "select": "nav.user_panel.presence",
      "when": { "slot": "dnd" },
      "style": { "background": "$color.danger" }
    },
    {
      "select": "nav.user_panel.name",
      "style": { "font": "$font.small", "color": "$color.text.primary" }
    },
    {
      "select": "nav.user_panel.status",
      "style": { "font": { "size": 11, "lineHeight": 14 }, "color": "$color.text.muted" }
    },

    {
      "select": "nav.member_list",
      "style": { "background": "$color.bg.sunken", "padding": [8, 0, 8, 0], "gap": 2 }
    },
    {
      "select": "nav.member_list.group",
      "style": {
        "font": { "size": 11, "lineHeight": 24, "weight": 600 },
        "color": "$color.text.muted",
        "padding": [16, 8, 4, 16]
      }
    },
    {
      "select": "nav.member_list.item",
      "style": { "padding": [5, 8, 5, 8], "margin": [0, 8, 0, 8], "gap": "$space.2", "radius": "$radius.md", "transition": "$motion.fast" }
    },
    {
      "select": "nav.member_list.item",
      "when": { "state": "hover" },
      "style": { "background": "$color.bg.hover" }
    },
    {
      "select": "nav.member_list.item.avatar",
      "style": { "radius": "$radius.full", "background": "$color.bg.raised" }
    },
    {
      "select": "nav.member_list.item.presence",
      "style": {
        "width": 14,
        "height": 14,
        "margin": [20, 0, 0, 20],
        "radius": "$radius.full",
        "background": "$color.text.muted",
        "borderColor": "$color.bg.sunken",
        "borderWidth": 2
      }
    },
    {
      "select": "nav.member_list.item.presence",
      "when": { "slot": "online" },
      "style": { "background": "#3ba55d" }
    },
    {
      "select": "nav.member_list.item.presence",
      "when": { "slot": "idle" },
      "style": { "background": "#faa81a" }
    },
    {
      "select": "nav.member_list.item.presence",
      "when": { "slot": "dnd" },
      "style": { "background": "$color.danger" }
    },
    {
      "select": "nav.member_list.item.name",
      "style": { "font": "$font.small", "color": "$color.text.secondary" }
    },
    {
      "select": "nav.member_list.item.name",
      "style": { "color": "$data.tint" }
    },

    {
      "select": "chat.view",
      "style": { "background": "$color.bg.base" }
    },
    {
      "select": "chat.header",
      "style": {
        "background": "$color.bg.base",
        "borderColor": "$color.border",
        "borderWidth": 1,
        "padding": [0, 16, 0, 16],
        "height": 48,
        "gap": 8,
        "shadow": "$shadow.raised"
      }
    },
    {
      "select": "chat.header.title",
      "style": { "font": "$font.title" }
    },
    {
      "select": "chat.header.topic",
      "style": { "font": "$font.small", "color": "$color.text.muted" }
    },

    {
      "select": "chat.message",
      "style": { "padding": [4, 16, 4, 16], "gap": "$space.2", "transition": "$motion.fast" }
    },
    {
      "select": "chat.message",
      "when": { "state": "hover" },
      "style": { "background": "$color.bg.hover" }
    },
    {
      "select": "chat.message",
      "when": { "state": "grouped" },
      "style": { "padding": [0, 16, 0, 64] }
    },
    {
      "select": "chat.message",
      "when": { "state": "mentioned" },
      "style": { "background": "#7c6cf01a", "borderColor": "$color.accent", "borderWidth": 2 }
    },
    {
      "select": "chat.message.avatar",
      "style": { "width": 40, "height": 40, "radius": "$radius.full", "background": "$color.bg.raised" }
    },
    {
      "select": "chat.message.header.author",
      "style": { "font": "$font.title", "color": "$color.text.primary" }
    },
    {
      "select": "chat.message.header.author",
      "style": { "color": "$data.tint" }
    },
    {
      "select": "chat.message.header.timestamp",
      "style": { "font": "$font.small", "color": "$color.text.muted" }
    },
    {
      "select": "chat.message.content",
      "style": { "color": "$color.text.primary" }
    },
    {
      "select": "primitive.text",
      "when": { "slot": "bold" },
      "style": { "font": { "weight": 700 } }
    },
    {
      "select": "primitive.text",
      "when": { "slot": "italic" },
      "style": { "font": { "italic": true } }
    },
    {
      "select": "primitive.text",
      "when": { "slot": "underline" },
      "style": { "decoration": "underline" }
    },
    {
      "select": "primitive.text",
      "when": { "slot": "strike" },
      "style": { "decoration": "strikethrough", "color": "$color.text.muted" }
    },
    {
      "select": "primitive.text",
      "when": { "slot": "spoiler" },
      "style": { "color": "$color.bg.hover" }
    },
    {
      "select": "primitive.text",
      "when": { "slot": "code" },
      "style": { "font": "$font.mono", "color": "$color.text.primary" }
    },
    {
      "select": "primitive.text",
      "when": { "slot": "link" },
      "style": { "color": "$color.brand" }
    },
    {
      "select": "primitive.text",
      "when": { "slot": "mention" },
      "style": { "color": "$color.brand", "font": { "weight": 600 } }
    },
    {
      "select": "primitive.text",
      "when": { "slot": "h1" },
      "style": { "font": { "size": 22, "lineHeight": 30, "weight": 700 }, "margin": [8, 0, 4, 0] }
    },
    {
      "select": "primitive.text",
      "when": { "slot": "h2" },
      "style": { "font": { "size": 18, "lineHeight": 26, "weight": 700 }, "margin": [8, 0, 4, 0] }
    },
    {
      "select": "primitive.text",
      "when": { "slot": "h3" },
      "style": { "font": { "size": 15, "lineHeight": 22, "weight": 700 }, "margin": [8, 0, 4, 0] }
    },
    {
      "select": "primitive.text",
      "when": { "slot": "subtext" },
      "style": { "font": "$font.small", "color": "$color.text.muted" }
    },
    {
      "select": "primitive.text",
      "when": { "slot": "bullet" },
      "style": { "color": "$color.text.secondary" }
    },
    {
      "select": "primitive.divider",
      "when": { "slot": "quote_bar" },
      "style": { "width": 4, "radius": "$radius.sm", "background": "$color.border", "margin": [2, 8, 2, 0] }
    },
    {
      "select": "layout.column",
      "when": { "slot": "list" },
      "style": { "gap": 2, "margin": [2, 0, 2, 0] }
    },
    {
      "select": "layout.row",
      "when": { "slot": "li0" },
      "style": { "gap": 6 }
    },
    {
      "select": "layout.row",
      "when": { "slot": "li1" },
      "style": { "gap": 6, "margin": [0, 0, 0, 16] }
    },
    {
      "select": "layout.row",
      "when": { "slot": "li2" },
      "style": { "gap": 6, "margin": [0, 0, 0, 32] }
    },
    {
      "select": "layout.row",
      "when": { "slot": "li3" },
      "style": { "gap": 6, "margin": [0, 0, 0, 48] }
    },
    {
      "select": "layout.row",
      "when": { "slot": "li4" },
      "style": { "gap": 6, "margin": [0, 0, 0, 64] }
    },
    {
      "select": "primitive.code_block",
      "style": {
        "font": "$font.mono",
        "background": "$color.bg.sunken",
        "borderColor": "$color.border",
        "borderWidth": 1,
        "radius": "$radius.md",
        "padding": [8, 10, 8, 10],
        "margin": [4, 0, 4, 0]
      }
    },
    {
      "select": "overlay.scrim",
      "when": { "slot": "dim" },
      "style": { "background": "#00000080" }
    },
    {
      "select": "overlay.popover",
      "style": {
        "background": "$color.bg.raised",
        "borderColor": "$color.border",
        "borderWidth": 1,
        "radius": "$radius.md",
        "padding": [6, 0, 6, 0],
        "shadow": "$shadow.raised",
        "minWidth": 180
      }
    },
    {
      "select": "overlay.sheet",
      "style": {
        "background": "$color.bg.raised",
        "radius": "$radius.lg",
        "padding": [8, 0, 16, 0],
        "shadow": "$shadow.raised"
      }
    },
    {
      "select": "overlay.sheet.handle",
      "style": {
        "width": 36,
        "height": 4,
        "radius": "$radius.sm",
        "background": "$color.text.muted",
        "margin": [4, 0, 10, 0]
      }
    },
    {
      "select": "overlay.menu",
      "style": { "gap": 1, "padding": [0, 6, 0, 6] }
    },
    {
      "select": "overlay.menu.item",
      "style": {
        "gap": 10,
        "padding": [7, 10, 7, 10],
        "radius": "$radius.sm",
        "transition": "$motion.fast"
      }
    },
    {
      "select": "overlay.menu.item",
      "when": { "state": "hover" },
      "style": { "background": "$color.bg.hover" }
    },
    {
      "select": "overlay.menu.item.icon",
      "style": { "width": 16, "height": 16, "color": "$color.text.secondary" }
    },
    {
      "select": "overlay.menu.item.icon",
      "when": { "slot": "danger" },
      "style": { "color": "$color.danger" }
    },
    {
      "select": "overlay.menu.item.label",
      "style": { "font": "$font.small", "color": "$color.text.primary" }
    },
    {
      "select": "overlay.menu.item.label",
      "when": { "slot": "danger" },
      "style": { "color": "$color.danger" }
    },
    {
      "select": "overlay.menu.separator",
      "style": { "height": 1, "background": "$color.border", "margin": [4, 0, 4, 0] }
    },
    {
      "select": "overlay.modal",
      "style": {
        "background": "$color.bg.raised",
        "borderColor": "$color.border",
        "borderWidth": 1,
        "radius": "$radius.lg",
        "padding": [20, 20, 16, 20],
        "shadow": "$shadow.raised",
        "gap": "$space.2",
        "minWidth": 320,
        "maxWidth": 440
      }
    },
    {
      "select": "overlay.modal.title",
      "style": { "font": "$font.title", "color": "$color.text.primary" }
    },
    {
      "select": "overlay.modal.body",
      "style": { "font": "$font.small", "color": "$color.text.secondary" }
    },
    {
      "select": "overlay.modal.preview",
      "style": {
        "font": "$font.small",
        "color": "$color.text.muted",
        "background": "$color.bg.sunken",
        "radius": "$radius.sm",
        "padding": [8, 10, 8, 10]
      }
    },
    {
      "select": "overlay.modal.actions",
      "style": { "gap": "$space.2", "margin": [8, 0, 0, 0] }
    },
    {
      "select": "overlay.modal.action",
      "style": {
        "background": "$color.bg.hover",
        "radius": "$radius.sm",
        "padding": [9, 12, 9, 12],
        "transition": "$motion.fast"
      }
    },
    {
      "select": "overlay.modal.action",
      "when": { "state": "hover" },
      "style": { "background": "$color.bg.selected" }
    },
    {
      "select": "overlay.modal.action.label",
      "style": { "font": "$font.small", "color": "$color.text.primary" }
    },
    {
      "select": "overlay.modal.action.label",
      "when": { "slot": "danger" },
      "style": { "color": "$color.danger" }
    },
    {
      "select": "chat.message.reply_ref",
      "style": { "font": "$font.small", "color": "$color.text.muted", "opacity": 0.8 }
    },
    {
      "select": "chat.message.embed",
      "style": {
        "background": "$color.bg.raised",
        "radius": "$radius.md",
        "padding": "$space.3",
        "borderColor": "$color.accent",
        "borderWidth": 4
      }
    },
    {
      "select": "chat.typing_indicator",
      "style": { "font": "$font.small", "color": "$color.text.muted" }
    },

    {
      "select": "chat.input",
      "style": { "padding": [0, 16, 16, 16] }
    },
    {
      "select": "chat.input.toolbar",
      "style": {
        "background": "$color.bg.sunken",
        "radius": "$radius.md",
        "padding": [6, 12, 6, 12],
        "margin": [0, 0, 2, 0]
      }
    },
    {
      "select": "primitive.text",
      "when": { "slot": "reply" },
      "style": { "font": "$font.small", "color": "$color.text.secondary" }
    },
    {
      "select": "primitive.text",
      "when": { "slot": "edit" },
      "style": { "font": "$font.small", "color": "$color.accent" }
    },
    {
      "select": "chat.input.field",
      "style": {
        "background": "$color.bg.raised",
        "radius": "$radius.md",
        "padding": "$space.3",
        "minHeight": 44
      }
    },
    {
      "select": "chat.input.field",
      "when": { "state": "focus" },
      "style": { "borderColor": "$color.accent", "borderWidth": 1 }
    },

    {
      "select": "primitive.mention",
      "style": { "background": "#7c6cf033", "color": "$color.accent", "radius": "$radius.sm" }
    },
    {
      "select": "primitive.link",
      "style": { "color": "$color.accent" }
    },
    {
      "select": "primitive.code_block",
      "style": {
        "background": "$color.bg.sunken",
        "font": "$font.mono",
        "radius": "$radius.sm",
        "padding": "$space.2",
        "borderColor": "$color.border",
        "borderWidth": 1
      }
    },
    {
      "select": "primitive.spoiler",
      "style": { "background": "$color.bg.selected", "color": "#00000000", "radius": "$radius.sm" }
    },
    {
      "select": "primitive.spoiler",
      "when": { "state": "active" },
      "style": { "background": "$color.bg.hover", "color": "$color.text.primary" }
    },
    {
      "select": "primitive.badge",
      "style": {
        "background": "$color.accent",
        "color": "#ffffff",
        "font": "$font.small",
        "radius": "$radius.sm",
        "padding": [1, 4, 1, 4]
      }
    },
    {
      "select": "primitive.button",
      "style": { "background": "$color.bg.raised", "radius": "$radius.sm", "padding": [6, 12, 6, 12] }
    },
    {
      "select": "primitive.button",
      "when": { "state": "hover" },
      "style": { "background": "$color.bg.hover" }
    },
    {
      "select": "primitive.button",
      "when": { "slot": "cancel_composing" },
      "style": {
        "width": 20,
        "height": 20,
        "padding": [0, 0, 0, 0],
        "background": "#00000000",
        "radius": "$radius.sm",
        "color": "$color.text.muted",
        "transition": "$motion.fast"
      }
    },
    {
      "select": "primitive.button",
      "when": { "slot": "cancel_composing", "state": "hover" },
      "style": { "background": "$color.bg.hover", "color": "$color.text.primary" }
    },
    {
      "select": "primitive.button",
      "when": { "state": "disabled" },
      "style": { "opacity": 0.4 }
    },
    {
      "select": "primitive.divider",
      "style": { "background": "$color.border", "height": 1 }
    },

    {
      "select": "layout.scrollbar",
      "style": { "width": 10, "padding": [4, 3, 4, 3] }
    },
    {
      "select": "layout.scrollbar.thumb",
      "style": { "background": "#ffffff26", "radius": "$radius.full", "transition": "$motion.fast" }
    },
    {
      "select": "layout.scrollbar.thumb",
      "when": { "state": "hover" },
      "style": { "background": "#ffffff4d" }
    },

    {
      "select": "chat.message",
      "when": { "maxWidth": 600 },
      "style": { "padding": [4, 8, 4, 8] }
    }
  ]
}
