{
  "name": "@gumicord/sdk",
  "version": "0.0.0",
  "description": "Gumicord plugin SDK",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "gumicord-plugin": "./bin/gumicord-plugin.mjs"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:types": "node test/run.mjs",
    "build:sample": "node bin/gumicord-plugin.mjs build ../examples/plugins/dev.gumicord.hello"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0"
  }
}
